# ── Obligatoire (install.sh les remplit pour vous) ────────────────────────
# Domaine de base : chaque service reçoit <service>-<projet>.<domaine>.
# Il faut un enregistrement DNS « *.apps.exemple.com  A  <IP du serveur> » (et « apps.exemple.com »).
RAIL_DOMAIN=apps.exemple.com
# Courriel pour Let's Encrypt (alertes d'expiration).
RAIL_ACME_EMAIL=vous@exemple.com
# Jeton d'administration (tableau de bord, CLI, API) : openssl rand -base64 36
RAIL_ADMIN_TOKEN=
# Clé de chiffrement des secrets au repos : openssl rand -hex 32. PERDUE = variables illisibles.
RAIL_SECRET_KEY=
# GID du groupe « docker » de l'hôte : getent group docker | cut -d: -f3
DOCKER_GID=

# ── Facultatif ────────────────────────────────────────────────────────────
# Adresse du tableau de bord (défaut : rail.<RAIL_DOMAIN>)
#RAIL_DASHBOARD_HOST=rail.apps.exemple.com
# Jeton GitHub par défaut pour les dépôts privés (fine-grained : Contents: read ; + Webhooks: write pour l'installation auto)
#GITHUB_TOKEN=
# Nombre de constructions simultanées, d'images gardées par service (retours arrière)
#RAIL_MAX_BUILDS=2
#RAIL_KEEP_IMAGES=5
# Attente maximale de la santé d'un nouveau déploiement, en secondes
#RAIL_HEALTH_TIMEOUT_S=120
# Limites par défaut d'un service (modifiables service par service)
#RAIL_DEFAULT_MEMORY_MB=512
#RAIL_DEFAULT_CPUS=1
# Adresse d'écoute de Traefik (défaut : toutes). Ex. 203.0.113.10 si le serveur a plusieurs IP.
#RAIL_BIND=0.0.0.0
