{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Valeurs du chart application",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "nomComplet": {
      "type": "string",
      "pattern": "^$|^[a-z][a-z0-9-]{0,39}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "depot": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+$"
        },
        "tag": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$",
          "not": {
            "const": "latest"
          }
        },
        "empreinte": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "politiqueTirage": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "repliques": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "variablePort": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "variableAdresse": {
      "type": "string",
      "pattern": "^$|^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existant": {
          "type": "string"
        },
        "scelles": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "jvm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pourcentageRam": {
          "type": "integer",
          "minimum": 25,
          "maximum": 90
        }
      }
    },
    "ressources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
            }
          },
          "required": [
            "memory"
          ]
        }
      },
      "required": [
        "requests",
        "limits"
      ]
    },
    "sondes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chemin": {
          "type": "string",
          "pattern": "^$|^/[A-Za-z0-9._~/%-]*$"
        },
        "demarrage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chemin": {
              "type": "string",
              "pattern": "^$|^/[A-Za-z0-9._~/%-]*$"
            },
            "delaiMax": {
              "type": "integer",
              "minimum": 10,
              "maximum": 900
            }
          }
        },
        "vivacite": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chemin": {
              "type": "string",
              "pattern": "^$|^/[A-Za-z0-9._~/%-]*$"
            }
          }
        },
        "preparation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chemin": {
              "type": "string",
              "pattern": "^$|^/[A-Za-z0-9._~/%-]*$"
            }
          }
        }
      }
    },
    "securite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "utilisateur": {
          "type": "integer",
          "minimum": 1000
        },
        "groupe": {
          "type": "integer",
          "minimum": 1000
        },
        "racineEnLectureSeule": {
          "type": "boolean"
        }
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nom",
          "chemin",
          "taille"
        ],
        "properties": {
          "nom": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,20}$"
          },
          "chemin": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9._/-]+$"
          },
          "taille": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
          }
        }
      }
    },
    "classeStockage": {
      "type": "string"
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actif": {
          "type": "boolean"
        },
        "hote": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        },
        "classe": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actif": {
              "type": "boolean"
            },
            "emetteur": {
              "enum": [
                "letsencrypt",
                "letsencrypt-staging",
                "auto-signe"
              ]
            }
          }
        },
        "corpsMaxMio": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "listeBlanche": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
          }
        },
        "entetes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9-]+$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "proxysDevant": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actif": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "depot": {
              "type": "string",
              "pattern": "^$|^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+$"
            },
            "tag": {
              "type": "string",
              "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$",
              "not": {
                "const": "latest"
              }
            },
            "empreinte": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "politiqueTirage": {
              "enum": [
                "IfNotPresent",
                "Always",
                "Never"
              ]
            }
          }
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "prefixeApi": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._/-]*$"
        },
        "ressources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
                }
              },
              "required": [
                "memory"
              ]
            }
          },
          "required": [
            "requests",
            "limits"
          ]
        }
      }
    },
    "sauvegardeAvantDeploiement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actif": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "pattern": "^docker\\.io/library/postgres:[0-9]+(\\.[0-9]+)?-alpine$"
        },
        "base": {
          "type": "string",
          "pattern": "^$|^[a-z_][a-z0-9_]*$"
        },
        "hote": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "utilisateur": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "valeur": {
              "type": "string"
            },
            "cle": {
              "type": "string"
            }
          }
        },
        "motDePasse": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cle": {
              "type": "string"
            }
          }
        },
        "garder": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "taille": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"
        }
      }
    },
    "metriques": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "boolean"
        },
        "chemin": {
          "type": "string",
          "pattern": "^$|^/[A-Za-z0-9._~/%-]*$"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actif": {
          "type": "boolean"
        },
        "minimum": {
          "type": "integer",
          "minimum": 1
        },
        "maximum": {
          "type": "integer",
          "minimum": 1
        },
        "cpuCible": {
          "type": "integer",
          "minimum": 10,
          "maximum": 100
        }
      }
    },
    "reseau": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sorties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cidr",
              "ports"
            ],
            "properties": {
              "cidr": {
                "type": "string",
                "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "image",
    "port",
    "ressources",
    "sondes",
    "securite",
    "ingress"
  ]
}
