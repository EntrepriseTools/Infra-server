# ── Obligatoire (install.sh les remplit pour vous) ────────────────────────
# Domaine de base : chaque service reçoit <service>-<projet>.<domaine>.
# Il faut un enregistrement DNS « *.apps.exemple.com  A  <IP du serveur> » (et « apps.exemple.com »).
RAIL_DOMAIN=apps.exemple.com
# Courriel pour Let's Encrypt (alertes d'expiration).
RAIL_ACME_EMAIL=vous@exemple.com
# Jeton d'administration : la clé de secours de l'installation. Il crée le premier
# compte, vaut un rôle d'administrateur pour l'API et la CLI, et se change ici.
# openssl rand -base64 36
RAIL_ADMIN_TOKEN=
# Clé de chiffrement des secrets au repos : openssl rand -hex 32. PERDUE = variables illisibles.
RAIL_SECRET_KEY=
# GID du groupe « docker » de l'hôte : getent group docker | cut -d: -f3
DOCKER_GID=

# ── Le premier compte (facultatif, mais c'est le plus simple) ────────────
# Renseignés, ils créent le compte administrateur au premier démarrage : on se
# connecte ensuite au tableau de bord avec cet identifiant et ce mot de passe.
# Laissés vides, le tableau de bord demande le jeton ci-dessus pour créer le compte.
#RAIL_ADMIN_LOGIN=ana
#RAIL_ADMIN_PASSWORD=
# Durée d'une session du tableau de bord, en heures
#RAIL_SESSION_HOURS=12

# ── Facultatif ────────────────────────────────────────────────────────────
# Adresse du tableau de bord (défaut : rail.<RAIL_DOMAIN>)
#RAIL_DASHBOARD_HOST=rail.apps.exemple.com
# Jeton GitHub par défaut pour les dépôts privés (fine-grained : Contents: read ;
# + Webhooks: write pour l'installation automatique). Chaque personne peut aussi
# relier le sien depuis « Mon compte » — celui-ci n'est qu'un dernier recours.
#GITHUB_TOKEN=
# Nombre de constructions simultanées, d'images gardées par service (retours arrière)
#RAIL_MAX_BUILDS=2
#RAIL_KEEP_IMAGES=5
# Attente maximale de la santé d'un nouveau déploiement, en secondes
#RAIL_HEALTH_TIMEOUT_S=120
# Limites par défaut d'un service (modifiables service par service)
#RAIL_DEFAULT_MEMORY_MB=512
#RAIL_DEFAULT_CPUS=1
# ── Par où le monde entre ────────────────────────────────────────────────
# Comment Rail obtient ses certificats, et donc quels ports il lui faut :
#   acme  (défaut) Rail tient le 80 ET le 443 — Let's Encrypt par défi HTTP-01.
#   proxy          un serveur devant (nginx…) fait déjà le HTTPS et transmet à Rail,
#                  qui n'écoute qu'en clair sur RAIL_HTTP_PORT. Aucun certificat ici.
#   dns            Rail peut vivre sur n'importe quels ports : le certificat s'obtient
#                  par DNS-01 (identifiants du fournisseur dans .env.dns).
#RAIL_TLS=acme
# Ports PUBLIÉS sur la machine (à l'intérieur, Traefik écoute toujours 80 et 443).
#RAIL_HTTP_PORT=80
#RAIL_HTTPS_PORT=443
# Adresse d'écoute de Traefik (défaut : toutes). Ex. 203.0.113.10 si le serveur a plusieurs IP.
#RAIL_BIND=0.0.0.0
# Adresse d'écoute du port HTTPS (install.sh met 127.0.0.1 en mode proxy).
#RAIL_BIND_TLS=0.0.0.0
# Comment le monde voit vos services (mode proxy : c'est l'adresse du serveur de devant).
#RAIL_SITE_SCHEME=https
#RAIL_SITE_PORT=443
# Fournisseur DNS pour RAIL_TLS=dns (cloudflare, ovh, gandiv5… liste : doc Traefik).
#RAIL_ACME_DNS_PROVIDER=cloudflare

# ── Exposition TCP, planification, sauvegardes ───────────────────────────
# Plage de ports que Rail peut publier sur la machine quand on expose une base
# (« Exposition TCP » dans les réglages d'un service). Ouvrez-les dans le pare-feu
# seulement si vous comptez vous en servir.
#RAIL_TCP_PORTS=20000-20050
# Adresse d'écoute de ces ports (127.0.0.1 pour « seulement depuis le serveur »)
#RAIL_TCP_BIND=0.0.0.0
# Nom d'hôte à montrer pour ces ports (défaut : RAIL_DOMAIN)
#RAIL_PUBLIC_HOST=serveur.exemple.com
# Fréquence de l'horloge interne (tâches planifiées, sauvegardes automatiques)
#RAIL_SCHEDULER_INTERVAL_S=30
# Durée maximale d'une exécution de tâche planifiée, en secondes
#RAIL_JOB_TIMEOUT_S=3600
# Nombre de sauvegardes gardées par base, par défaut (réglable base par base)
#RAIL_BACKUP_KEEP=7

# ── Surveillance ──────────────────────────────────────────────────────────
# Intervalle entre deux relevés (processeur, mémoire, réseau, état) et durée de conservation
#RAIL_METRICS_INTERVAL_S=15
#RAIL_METRICS_RETENTION_H=72
# Nombre d'événements gardés dans le fil d'activité
#RAIL_EVENTS_KEEP=5000
# Relancer automatiquement un conteneur tombé (« non » pour seulement alerter)
#RAIL_AUTO_HEAL=oui
# Rotation des journaux de VOS conteneurs (sinon, un service bavard remplit le disque)
#RAIL_CONTAINER_LOG_MB=10
#RAIL_CONTAINER_LOG_FILES=3

# ── Alertes ───────────────────────────────────────────────────────────────
# Un webhook qui reçoit les pannes et les échecs de déploiement (Slack, Discord, ou le vôtre)
#RAIL_NOTIFY_URL=https://hooks.slack.com/services/...
# Prévenir aussi des déploiements réussis
#RAIL_NOTIFY_SUCCESS=non
