# =====================================================================
# ENGENDRÉ par « infra porte @APP@ » depuis modeles/nginx/spa.conf.gabarit
# — ne pas modifier à la main : réécrit à chaque déploiement.
#
# Mode « spa » : nginx sert l'écran (fichiers statiques bâtis par le
# pipeline, rangés par `infra` dans @ECRAN@) et renvoie @API_PREFIXE@ vers
# l'application, sur la boucle locale. Même origine : ni CORS, ni adresse
# figée dans le livrable. (Procurement est dans ce mode.)
# =====================================================================

#HTTPS#server {
#HTTPS#    listen 443 ssl;
#HTTPS#    listen [::]:443 ssl;
#HTTPS#    server_name @NOM@;
#HTTPS#    ssl_certificate     @CERT@;
#HTTPS#    ssl_certificate_key @CLE@;
#HTTPS#    ssl_protocols TLSv1.2 TLSv1.3;
#HTTPS#    ssl_prefer_server_ciphers off;
#HTTPS#    ssl_session_cache shared:@APP@_tls:10m;
#HTTPS#    ssl_session_timeout 1d;
#HTTPS#    add_header Strict-Transport-Security "max-age=31536000" always;
#HTTP#server {
#HTTP#    listen 80;
#HTTP#    listen [::]:80;
#HTTP#    server_name @NOM@;

    #ACCES#

    client_max_body_size @CORPS_MAX@;

    add_header X-Infra-App @APP@ always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    # L'API : pas de tampon (flux SSE possibles), délai réglable.
    location @API_PREFIXE@ {
        proxy_pass http://127.0.0.1:@PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_buffering off;
        proxy_read_timeout @DELAI@;
    }

    # L'écran. Les fichiers empreintés de Vite se cachent un an ; index.html
    # jamais, sinon un déploiement ne se voit pas. `expires` et non
    # `add_header` : un add_header dans un location effacerait ceux du
    # serveur, X-Infra-App compris.
    root @ECRAN@;
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}

#HTTPS## Le port 80 ne sert qu'à monter en HTTPS.
#HTTPS#server {
#HTTPS#    listen 80;
#HTTPS#    listen [::]:80;
#HTTPS#    server_name @NOM@;
#HTTPS#    return 301 https://$host$request_uri;
#HTTPS#}
