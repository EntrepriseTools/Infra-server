#!/usr/bin/env bash
# Double de docker : images, étiquettes et conteneurs, rangés dans $BANC/docker/.
# Une « image » est un fichier qui contient sa référence d'origine (repo:sha) ;
# `docker tag` recopie ce contenu, donc `en-service` désigne une vraie version.
. "$(dirname "$0")/_commun"
D="$BANC/docker"; mkdir -p "$D/images" "$D/run"
img() { printf '%s' "$1" | tr '/:' '__'; }
case "$1" in
  info) [ -f "$BANC/docker_mort" ] && exit 1; exit 0 ;;
  version) echo 27.0.0; exit 0 ;;
  load) noter "docker load"; ref="$(head -1)"; [ -n "$ref" ] || exit 1
        printf '%s\n' "$ref" > "$D/images/$(img "$ref")"; echo "Loaded image: $ref"; exit 0 ;;
  image) [ "$2" = inspect ] && [ -f "$D/images/$(img "$3")" ]; exit ;;
  tag) [ -f "$D/images/$(img "$2")" ] || exit 1
       cat "$D/images/$(img "$2")" > "$D/images/$(img "$3")"; noter "docker tag $2 $3"; exit 0 ;;
  images) p="$(img "$2")_"; for f in "$D"/images/"$p"*; do [ -e "$f" ] || continue
            t="${f##*/}"; echo "${t#"$p"}"; done; exit 0 ;;
  rmi) rm -f "$D/images/$(img "$2")"; noter "docker rmi $2"; exit 0 ;;
  ps) # « docker ps --filter label=com.docker.compose.project=P » : les conteneurs du projet P
      p=""; sv=""
      for a in "$@"; do case "$a" in
        label=com.docker.compose.project=*) p="${a##*=}" ;;
        label=com.docker.compose.service=*) sv="${a##*=}" ;;
      esac; done
      if [ -n "$p" ] && [ -f "$D/run/$p" ]; then
        read -r _ _ svc < "$D/run/$p"
        { [ -z "$sv" ] || [ "$sv" = "${svc:-}" ]; } && echo "id-$p"
      fi
      exit 0 ;;
  compose)
    shift; projet=""; fichier=""
    while [ $# -gt 0 ]; do case "$1" in -p) projet="$2"; shift 2 ;; -f) fichier="$2"; shift 2 ;; *) break ;; esac; done
    case "$1" in
      version) echo "v2.29.0"; exit 0 ;;
      up)
        repo="$(sed -n 's/^ *image: \([^:]*\):.*/\1/p' "$fichier")"
        port="$(awk '/environment:/{e=1;next} e && /^      [A-Z_]*: "[0-9]+"/{gsub(/[^0-9]/,"",$2); print $2; exit}' "$fichier")"
        ref="$(cat "$D/images/$(img "$repo:en-service")" 2>/dev/null)" || exit 1
        printf '%s %s %s\n' "$port" "$ref" "${@: -1}" > "$D/run/$projet"
        noter "docker compose up $ref"; exit 0 ;;
      ps) [ -f "$D/run/$projet" ] && echo "id-$projet"; exit 0 ;;
      stop|down|rm) rm -f "$D/run/$projet"; noter "docker compose $1"; exit 0 ;;
      logs) echo "(journal simulé)"; exit 0 ;;
    esac ;;
esac
exit 0
