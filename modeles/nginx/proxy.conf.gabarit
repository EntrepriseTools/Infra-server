# =====================================================================
# ENGENDRÉ par « infra porte @APP@ » depuis modeles/nginx/proxy.conf.gabarit
# — ne pas modifier à la main : réécrit à chaque déploiement.
#
# Mode « proxy » : l'application sert TOUT elle-même (écran + /api), sur la
# boucle locale. nginx ne fait que TLS, en-têtes, et renvoi.
# (La paie et Pilotage sont dans ce mode.)
# =====================================================================

#HTTPS#server {
#HTTPS#    listen 443 ssl;
#HTTPS#    listen [::]:443 ssl;
#HTTPS#    server_name @NOM@;
#HTTPS#    ssl_certificate     @CERT@;
#HTTPS#    ssl_certificate_key @CLE@;
#HTTPS#    ssl_protocols TLSv1.2 TLSv1.3;
#HTTPS#    ssl_prefer_server_ciphers off;
#HTTPS#    ssl_session_cache shared:@APP@_tls:10m;
#HTTPS#    ssl_session_timeout 1d;
#HTTPS#    add_header Strict-Transport-Security "max-age=31536000" always;
#HTTP#server {
#HTTP#    listen 80;
#HTTP#    listen [::]:80;
#HTTP#    server_name @NOM@;

    #ACCES#

    client_max_body_size @CORPS_MAX@;

    # Par où l'on est entré : `infra` le lit pour prouver que c'est CE bloc
    # qui répond au nom, et pas le serveur par défaut.
    add_header X-Infra-App @APP@ always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location / {
        proxy_pass http://127.0.0.1:@PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_read_timeout @DELAI@;
    }
}

#HTTPS## Le port 80 ne sert qu'à monter en HTTPS.
#HTTPS#server {
#HTTPS#    listen 80;
#HTTPS#    listen [::]:80;
#HTTPS#    server_name @NOM@;
#HTTPS#    return 301 https://$host$request_uri;
#HTTPS#}
